# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration - Different models for different workflows
# Use gpt-4o or other supported models from your OpenAI account
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CONTENT=gpt-4o
OPENAI_MODEL_DIGITAL_PRODUCT=gpt-4o
OPENAI_MODEL_SEO=gpt-4o
OPENAI_MODEL_SOCIAL=gpt-4o

# Token Configuration - Optimal tokens for different workflows
# Adjust based on your needs and budget
MAX_TOKENS_CONTENT=2000
MAX_TOKENS_DIGITAL_PRODUCT=4000
MAX_TOKENS_SEO=1500
MAX_TOKENS_SOCIAL=1000

# Topic file configuration
TOPICS_FILE_PATH=topics.txt

# Blogger API Configuration
BLOGGER_API_KEY=your_blogger_api_key_here
BLOGGER_BLOG_ID=your_blog_id_here

# Google OAuth Credentials (for Blogger API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SEO Tools API Keys (Optional)
SEMRUSH_API_KEY=your_semrush_api_key_here
AHREFS_API_KEY=your_ahrefs_api_key_here

# Social Media API Keys (Optional)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Cloudinary Configuration (for image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gumroad Configuration (for digital products)
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token
ENABLE_DIGITAL_PRODUCTS=true
DEFAULT_PRODUCT_PRICE=9.99

# Configuration
BLOG_DOMAIN=simplifyyourday.blogspot.com
BLOG_NICHE=software_development/programming
TARGET_AUDIENCE=software_engineers/developers
